# ErgoSight CV — OpenCV & AWS IoT Greengrass V2 / Bedrock Edge Safety Monitor (Port 5183)
# Works 100% locally in deterministic_local mode with zero cloud credentials required.

VITE_HOST=127.0.0.1
VITE_PORT=5183
VITE_STRICT_PORT=true
VITE_DEFAULT_MODE=deterministic_local

# Optional AWS IoT Greengrass V2 & Amazon Bedrock AgentCore Configuration
AWS_REGION=us-east-1
VITE_GREENGRASS_COMPONENT_NAME=com.ergosight.edge.PoseSafetyMonitor
VITE_BEDROCK_AGENT_ID=
